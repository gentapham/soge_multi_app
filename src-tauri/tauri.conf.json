{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SOGE Multi App",
  "version": "0.1.0",
  "identifier": "vn.sogestore.multiapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SOGE Multi App",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SOGE Store",
    "shortDescription": "Tải & cài phần mềm nhanh",
    "copyright": "© SOGE Store",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Vietnamese", "English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
